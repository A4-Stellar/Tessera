<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Tessera.SDK</RootNamespace>
    <AssemblyName>Tessera.SDK</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>false</IsTrimmable>
    <!-- Public model properties mirror the API schema documented on each type. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- NuGet package metadata (dotnet pack) -->
    <PackageId>Tessera.SDK</PackageId>
    <Version>0.1.0</Version>
    <Authors>Tessera Contributors</Authors>
    <Description>Official .NET client SDK for the Tessera real-world asset (RWA) indexing API on Stellar: typed REST client, HttpClientFactory integration and IAsyncEnumerable event streaming.</Description>
    <PackageTags>tessera;stellar;soroban;rwa;tokenization;sdk</PackageTags>
    <PackageProjectUrl>https://github.com/A4-Stellar/Tessera</PackageProjectUrl>
    <RepositoryUrl>https://github.com/A4-Stellar/Tessera</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tessera.SDK.Tests" />
  </ItemGroup>

</Project>
