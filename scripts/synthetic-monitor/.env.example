# ==========================================
# Tessera Synthetic Health Monitor Configuration
# ==========================================

# Target Stellar / Soroban RPC URL
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Target Tessera Indexing REST API Base URL
TESSERA_API_URL=http://localhost:8080

# Monitoring Interval in seconds (default: 300 = 5 minutes)
CHECK_INTERVAL_SECONDS=300

# Probe Timeout per request in milliseconds (default: 10000 = 10s)
PROBE_TIMEOUT_MS=10000

# Consecutive Failure Threshold before triggering critical alerts (default: 2)
CONSECUTIVE_FAILURE_THRESHOLD=2

# Maximum allowable age for indexer snapshots before flagging stale indexer gap (seconds)
MAX_SNAPSHOT_AGE_SECONDS=60

# ------------------------------------------
# Alerting Webhook Integrations
# ------------------------------------------

# Discord Webhook Integration (leave empty to disable)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Telegram Bot Alerting Integration (leave empty to disable)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=-1001234567890

# ------------------------------------------
# Soroban Deployed Contract IDs (Testnet Defaults)
