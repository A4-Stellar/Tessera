# Soroban RPC endpoint the indexer polls.
RWA_RPC_URL=https://soroban-testnet.stellar.org

# Deployed contract ids (Testnet defaults from the contracts repo).
RWA_REGISTRY_ID=CBX5SMLTXX6JP4HA5GQIO2V6QM7WCUGL2GZ6D4U773HMRI6RXISKPUR3
RWA_DIVIDEND_ID=CAR4XY3CEBQWFOL27JEWFW34KXSIZA7RFKDQMEIV7ZU723RWY37I2SYX

# A funded account used only as the (unsigned) source for read simulations.
RWA_READ_SOURCE=GAIQGTOBTTLLDJ4SWGGESM7UWJ2DI4K3ZNHUSHPDKJL2IE5FKY3BSRAA

# Issue #6 — historical fiat-equivalent pricing for dividend distributions.
# All optional; when unset, dividends simply report `fiat_equivalent_usd: null`.
#
# Horizon instance used for ledger close-time and trade_aggregations lookups.
# RWA_HORIZON_URL=https://horizon-testnet.stellar.org
#
# USD-pegged reference asset used as the trade_aggregations counter asset.
# RWA_USD_ASSET_CODE=USDC
# RWA_USD_ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
#
# Admin-configured payment_token contract -> classic asset mapping. A SAC's
# contract id can't be decoded back to its (code, issuer) from this codebase
# alone (see api/src/indexer/price_feed.rs), so any payment_token you want
# fiat pricing for must be listed here explicitly.
# RWA_ASSET_PRICE_MAP={"CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC":{"code":"USDC","issuer":"GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5"}}

# HTTP port.
PORT=8080

# Log filter.
RUST_LOG=stellar_rwa_api=info,tower_http=warn
