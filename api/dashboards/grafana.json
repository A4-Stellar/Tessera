{
  "title": "Tessera API",
  "uid": "tessera-api",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "tags": ["tessera", "stellar", "soroban"],
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (route, method) (rate(rwa_http_requests_total[5m]))",
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP request rate by status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (status) (rate(rwa_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP request latency (p50/p95/p99) by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, route) (rate(rwa_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{route}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(rwa_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{route}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(rwa_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{route}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Soroban RPC simulation duration (p95) by method",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, method) (rate(soroban_rpc_simulation_duration_seconds_bucket[5m])))",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "RPC failures by classification",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (classification) (rate(rwa_rpc_failures_total[5m]))",
          "legendFormat": "{{classification}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Indexer snapshot rebuild duration (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(indexer_snapshot_rebuild_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 snapshot rebuild"
        }
      ]
    },
    {
      "id": 7,
      "title": "Indexer refresh outcome rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(rwa_indexer_refresh_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Per-asset read errors",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (asset_id, read) (rate(rwa_indexer_asset_read_errors_total[15m]))",
          "legendFormat": "asset {{asset_id}} / {{read}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Active WebSocket connections",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "The API currently serves plain HTTP only; this gauge is registered at 0 and becomes live once a WebSocket transport is added (see api/src/main.rs).",
      "targets": [{ "expr": "active_websocket_connections" }]
    },
    {
      "id": 10,
      "title": "Last successful indexer refresh",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum(rate(rwa_indexer_refresh_total{outcome=\"success\"}[15m]))" }]
    },
    {
      "id": 11,
      "title": "Bridge monitoring",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 },
      "panels": []
    },
    {
      "id": 12,
      "title": "Bridge packets by status",
      "description": "SendPacket events paired with their RecvPacket (issue #475). Timeouts had no RecvPacket within expected_relay_ledgers.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 41 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum by (status) (rwa_bridge_packets)", "legendFormat": "{{status}}" }]
    },
    {
      "id": 13,
      "title": "Bridge timeouts (1h)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 8, "y": 41 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      },
      "targets": [{ "expr": "sum(increase(rwa_bridge_timeouts_total[1h]))" }]
    },
    {
      "id": 14,
      "title": "Bridge anomaly score (bps) by destination chain",
      "description": "z-score of outbound volume/velocity scaled to basis points. The contract's circuit breaker opens at its anomaly_threshold_bps (8000 in the reference config).",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 41 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "max": 10000,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5000 }, { "color": "red", "value": 8000 }] }
        }
      },
      "targets": [{ "expr": "max by (chain) (rwa_bridge_anomaly_score_bps)", "legendFormat": "{{chain}}" }]
    },
    {
      "id": 15,
      "title": "Bridge outbound volume by destination chain",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 41 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum by (chain) (rate(rwa_bridge_outbound_amount_total[10m]))", "legendFormat": "{{chain}}" }]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  }
}
