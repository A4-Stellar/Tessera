#![no_std]

use soroban_sdk::{
    contract, contracterror, contractimpl, contracttype, panic_with_error, Address, Env, String,
};

pub const ASSET_TYPE: &str = "{{asset_type}}";
pub const COMPLIANCE_MODEL: &str = "{{compliance_model}}";
pub const DIVIDEND_STRATEGY: &str = "{{dividend_strategy}}";

#[contracterror]
#[derive(Copy, Clone, Debug, Eq, PartialEq, Ord, PartialOrd)]
#[repr(u32)]
pub enum Error {
    AlreadyInitialized = 1,
    NotInitialized = 2,
    Unauthorized = 3,
    InvalidAmount = 4,
    InsufficientBalance = 5,
    DistributionNotFound = 6,
    AlreadyClaimed = 7,
    NothingToClaim = 8,
    NotCompliant = 9,
}

#[contracttype]
#[derive(Clone, Debug, Eq, PartialEq)]
pub struct AssetDetails {
    pub name: String,
    pub symbol: String,
    pub asset_type: String,
    pub compliance_model: String,
    pub dividend_strategy: String,
    pub admin: Address,
    pub total_supply: i128,
}

#[contracttype]
#[derive(Clone, Debug, Eq, PartialEq)]
pub struct Distribution {
    pub id: u64,
    pub amount: i128,
    pub created_at: u32,
}

#[derive(Clone)]
#[contracttype]
enum DataKey {
    Details,
    Balance(Address),
    Compliance(Address),
    NextDistribution,
    Distribution(u64),
    Claimed(u64, Address),
}

#[contract]
pub struct {{contract_name}};

#[contractimpl]
impl {{contract_name}} {
    pub fn initialize(env: Env, admin: Address, name: String, symbol: String, total_supply: i128) {
        if env.storage().instance().has(&DataKey::Details) {
            panic_with_error!(env, Error::AlreadyInitialized);
        }
        admin.require_auth();
        if total_supply < 0 {
            panic_with_error!(env, Error::InvalidAmount);
        }
        let details = AssetDetails {
            name,
            symbol,
            asset_type: String::from_str(&env, ASSET_TYPE),
            compliance_model: String::from_str(&env, COMPLIANCE_MODEL),
            dividend_strategy: String::from_str(&env, DIVIDEND_STRATEGY),
            admin: admin.clone(),
            total_supply,
        };
        env.storage().instance().set(&DataKey::Details, &details);
        env.storage()
            .persistent()
            .set(&DataKey::Balance(admin), &total_supply);
    }

    pub fn details(env: Env) -> AssetDetails {
        match env.storage().instance().get(&DataKey::Details) {
            Some(details) => details,
            None => panic_with_error!(env, Error::NotInitialized),
        }
    }

    pub fn asset_type(env: Env) -> String {
        String::from_str(&env, ASSET_TYPE)
    }

    pub fn compliance_model(env: Env) -> String {
        String::from_str(&env, COMPLIANCE_MODEL)
    }

    pub fn dividend_strategy(env: Env) -> String {
        String::from_str(&env, DIVIDEND_STRATEGY)
    }

    pub fn total_supply(env: Env) -> i128 {
        Self::details(env).total_supply
    }

    pub fn balance(env: Env, holder: Address) -> i128 {
        env.storage()
            .persistent()
            .get(&DataKey::Balance(holder))
            .unwrap_or(0)
    }

    pub fn is_compliant(env: Env, holder: Address) -> bool {
        if COMPLIANCE_MODEL == "permissionless" {
            return true;
        }
        env.storage()
            .persistent()
            .get(&DataKey::Compliance(holder))
            .unwrap_or(false)
    }

    pub fn set_compliance(env: Env, admin: Address, holder: Address, allowed: bool) {
        Self::require_admin(&env, &admin);
        env.storage()
            .persistent()
            .set(&DataKey::Compliance(holder), &allowed);
    }

    pub fn transfer(env: Env, from: Address, to: Address, amount: i128) {
        from.require_auth();
        if amount <= 0 {
            panic_with_error!(env, Error::InvalidAmount);
        }
        if !Self::is_compliant(env.clone(), from.clone()) {
            panic_with_error!(env, Error::NotCompliant);
        }
        if !Self::is_compliant(env.clone(), to.clone()) {
            panic_with_error!(env, Error::NotCompliant);
        }
        let from_balance: i128 = env
            .storage()
            .persistent()
            .get(&DataKey::Balance(from.clone()))
            .unwrap_or(0);
        let to_balance: i128 = env
            .storage()
            .persistent()
            .get(&DataKey::Balance(to.clone()))
            .unwrap_or(0);
        if from_balance < amount {
            panic_with_error!(env, Error::InsufficientBalance);
        }
        env.storage()
            .persistent()
            .set(&DataKey::Balance(from), &(from_balance - amount));
        env.storage()
            .persistent()
            .set(&DataKey::Balance(to), &(to_balance + amount));
    }

    pub fn create_distribution(env: Env, admin: Address, amount: i128) -> u64 {
        Self::require_admin(&env, &admin);
        if amount <= 0 {
            panic_with_error!(env, Error::InvalidAmount);
        }
        let id: u64 = env
            .storage()
            .instance()
            .get(&DataKey::NextDistribution)
            .unwrap_or(0);
        if id == u64::MAX {
            panic_with_error!(env, Error::InvalidAmount);
        }
        let next_id = id + 1;
        env.storage()
            .instance()
            .set(&DataKey::NextDistribution, &next_id);
        let distribution = Distribution {
            id,
            amount,
            created_at: env.ledger().sequence(),
        };
        env.storage()
            .persistent()
            .set(&DataKey::Distribution(id), &distribution);
        id
    }

    pub fn distribution(env: Env, distribution_id: u64) -> Distribution {
        match env
            .storage()
            .persistent()
            .get(&DataKey::Distribution(distribution_id))
        {
            Some(distribution) => distribution,
            None => panic_with_error!(env, Error::DistributionNotFound),
        }
    }

    pub fn dividend_preview(env: Env, distribution_id: u64, holder: Address) -> i128 {
        let distribution: Distribution = match env
            .storage()
            .persistent()
            .get(&DataKey::Distribution(distribution_id))
        {
            Some(distribution) => distribution,
            None => return 0,
        };
        let total_supply = Self::total_supply(env.clone());
        let balance = Self::balance(env, holder);
        if distribution.amount <= 0 || total_supply <= 0 || balance <= 0 {
            return 0;
        }
        match DIVIDEND_STRATEGY {
            "proportional" => distribution.amount.saturating_mul(balance) / total_supply,
            "fixed" => distribution.amount,
            "tiered" => {
                let tier_cap = total_supply / 10;
                let tier_balance = if tier_cap > 0 && balance > tier_cap {
                    tier_cap
                } else {
                    balance
                };
                distribution.amount.saturating_mul(tier_balance) / total_supply
            }
            _ => 0,
        }
    }

    pub fn claim_dividend(env: Env, distribution_id: u64, holder: Address) -> i128 {
        holder.require_auth();
        let key = DataKey::Claimed(distribution_id, holder.clone());
        if env.storage().persistent().has(&key) {
            panic_with_error!(env, Error::AlreadyClaimed);
        }
        let amount = Self::dividend_preview(env.clone(), distribution_id, holder);
        if amount <= 0 {
            panic_with_error!(env, Error::NothingToClaim);
        }
        env.storage().persistent().set(&key, &true);
        amount
    }

    pub fn version(_env: Env) -> u64 {
        1
    }

    fn require_admin(env: &Env, admin: &Address) {
        let details: AssetDetails = match env.storage().instance().get(&DataKey::Details) {
            Some(details) => details,
            None => panic_with_error!(env, Error::NotInitialized),
        };
        admin.require_auth();
        if admin != &details.admin {
            panic_with_error!(env, Error::Unauthorized);
        }
    }
}
