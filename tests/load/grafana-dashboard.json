{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "title": "Tessera API Load Testing & SLO Dashboard",
  "tags": ["tessera", "load-test", "k6", "slo"],
  "timezone": "browser",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "Request Rate by Persona (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "query": "SELECT count(\"value\") FROM \"http_reqs\" WHERE $timeFilter GROUP BY time($__interval), \"persona\" fill(0)",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Response Latency Percentiles (p50, p90, p99, p999)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "query": "SELECT percentile(\"value\", 50) as \"p50\", percentile(\"value\", 90) as \"p90\", percentile(\"value\", 99) as \"p99\", percentile(\"value\", 99.9) as \"p999\" FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time($__interval)",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 3,
      "title": "SLO Violation Threshold (p99 < 100ms)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "query": "SELECT percentile(\"value\", 99) FROM \"http_req_duration\" WHERE $timeFilter",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "max": 200,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 100 }
            ]
          },
          "unit": "ms"
        }
      }
    },
    {
      "id": 4,
      "title": "Error Rate (SLO < 0.1%)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "query": "SELECT mean(\"value\") * 100 FROM \"http_req_failed\" WHERE $timeFilter",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 5,
      "title": "WebSocket Streaming Messages / sec",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "query": "SELECT count(\"value\") FROM \"ws_message_duration_ms\" WHERE $timeFilter GROUP BY time($__interval) fill(0)",
          "rawQuery": true
        }
      ]
    }
  ]
}
